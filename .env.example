# Copia este fichero como .env.local y rellena los valores. .env.local NO se sube al repositorio.

# ─── IA: proveedor europeo con API compatible con OpenAI (#9, #10) ───
# URL base del proveedor (OVHcloud AI Endpoints o Scaleway Generative APIs)
AI_BASE_URL=
# Clave de la API (nunca en el código ni en el repositorio)
AI_API_KEY=
# Modelo mediano: tutor del módulo, corrector y analista del Radar
AI_MODEL_TUTOR=gemma-4-26b-a4b-it
# Modelo grande: generador de ejercicios (una vez por módulo)
AI_MODEL_GENERADOR=gemma-4-26b-a4b-it
# Límite diario de consultas al tutor por alumno
AI_LIMITE_DIARIO=30
# Sal secreta para generar los seudónimos de los alumnos (obligatoria si la IA es real).
# Cualquier texto largo y aleatorio. Si cambia, cambian todos los seudónimos.
AI_SEUDONIMO_SAL=

# Sin AI_BASE_URL o sin AI_API_KEY, la IA funciona en MODO SIMULADO (respuestas fijas, sin red).

# ─── Base de datos: PostgreSQL (#13) ───
DATABASE_URL=
# Cadena de conexión de PostgreSQL (en la UE). En Vercel la crea sola la integración de Neon o Supabase.

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (bucket con jurisdicción UE)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Stripe (modo test: sk_test_… y whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


#IA foro
AI_FORO_API_KEY=
AI_FORO_MODEL=
AI_FORO_BASE_URL=
AI_FORO_UMBRAL=